---
// Hero section — full-viewport, dark gradient backdrop with optional bg image.
// If /images/hero-bg.jpg is missing the gradient alone reads as a clean dark hero.
---

<section
  id="hero"
  class="relative min-h-screen flex items-center overflow-hidden"
>
  <!-- Background: gradient + optional image -->
  <div class="absolute inset-0 -z-10">
    <div
      class="absolute inset-0 bg-gradient-to-b from-black via-zinc-900 to-black"
    ></div>
    <div
      class="absolute inset-0 bg-center bg-cover opacity-25"
      style="background-image: url('/images/hero-bg.jpg');"
      aria-hidden="true"
    ></div>
    <!-- Vignette to keep text readable -->
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(10,10,10,0.4)_0%,_rgba(10,10,10,0.85)_100%)]"
    ></div>
  </div>

  <!-- Subtle gold ambient glow -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-32 -left-32 w-[420px] h-[420px] rounded-full bg-accent-gold/10 blur-[120px]"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-32 -right-32 w-[380px] h-[380px] rounded-full bg-accent-green/10 blur-[120px]"
  ></div>

  <div class="max-w-6xl mx-auto px-6 lg:px-8 w-full pt-24 pb-16">
    <div class="max-w-3xl">
      <!-- Brand badge -->
      <div
        class="inline-flex items-center gap-3 mb-8 animate-fade-in animate-delay-100"
      >
        <span class="block w-8 h-px bg-accent-gold"></span>
        <span class="text-xs md:text-sm font-medium tracking-[0.25em] uppercase text-accent-gold">
          Protocolo Duarte
        </span>
      </div>

      <!-- Headline with gold vertical accent -->
      <div class="relative pl-6 md:pl-8 border-l-2 border-accent-gold">
        <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.05] animate-rise-in animate-delay-200">
          El rendimiento no se
          <span class="text-gradient-gold">improvisa</span>.
          <br class="hidden sm:block" />
          Se <span class="text-gradient-gold">construye</span>.
        </h1>

        <p class="mt-6 md:mt-8 text-base sm:text-lg md:text-xl text-foreground/75 max-w-2xl animate-rise-in animate-delay-300">
          Negocios de alto nivel, disciplina física y mentalidad ejecutiva.
          Los tres pilares no son opcionales.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row gap-4 animate-rise-in animate-delay-400">
          <a
            href="#producto"
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-accent-gold text-base font-semibold text-black rounded-md hover:brightness-110 transition-[filter,transform] duration-200 hover:-translate-y-0.5 shadow-lg shadow-accent-gold/20"
          >
            Conoce el Tridente
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href="#sobre-mi"
            class="inline-flex items-center justify-center gap-2 px-7 py-4 border border-white/15 text-foreground/90 font-medium rounded-md hover:border-accent-gold hover:text-accent-gold transition-colors"
          >
            Sobre Protocolo Duarte
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll cue -->
  <div
    aria-hidden="true"
    class="absolute bottom-6 left-1/2 -translate-x-1/2 text-foreground/40 animate-fade-in animate-delay-400"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</section>
