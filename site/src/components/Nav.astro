---
// Sticky responsive navigation. Goes from transparent at top to
// translucent black with backdrop blur on scroll.
const links = [
  { href: '#sobre-mi', label: 'Sobre mí' },
  { href: '#producto', label: 'El Tridente' },
  { href: '#adquirir', label: 'Adquirir' },
];
---

<nav
  id="site-nav"
  role="navigation"
  aria-label="Navegación principal"
  class="fixed top-0 inset-x-0 z-50 transition-colors duration-300"
>
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Brand -->
      <a
        href="#hero"
        class="font-display font-bold tracking-tight text-lg md:text-xl text-accent-gold hover:opacity-80 transition-opacity"
      >
        Protocolo Duarte
      </a>

      <!-- Desktop links -->
      <ul class="hidden md:flex items-center gap-8 text-sm font-medium">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="text-foreground/80 hover:text-accent-gold transition-colors"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Mobile toggle -->
      <button
        id="nav-toggle"
        type="button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Abrir menú"
        class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded text-foreground hover:text-accent-gold focus:outline-none focus:ring-1 focus:ring-accent-gold"
      >
        <svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="nav-icon-close" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="md:hidden hidden pb-4">
      <ul class="flex flex-col gap-1 bg-black/90 backdrop-blur-md rounded-lg border border-white/5 p-2">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="block px-4 py-3 text-foreground/90 hover:text-accent-gold hover:bg-white/5 rounded transition-colors"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</nav>

<script is:inline>
  // Sticky background swap on scroll
  (function () {
    const nav = document.getElementById('site-nav');
    const onScroll = () => {
      if (window.scrollY > 16) {
        nav.classList.add('bg-black/80', 'backdrop-blur-md', 'border-b', 'border-white/5');
      } else {
        nav.classList.remove('bg-black/80', 'backdrop-blur-md', 'border-b', 'border-white/5');
      }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Mobile menu toggle
    const btn = document.getElementById('nav-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('nav-icon-open');
    const iconClose = document.getElementById('nav-icon-close');
    btn.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(isOpen));
      iconOpen.classList.toggle('hidden', isOpen);
      iconClose.classList.toggle('hidden', !isOpen);
    });
    // Close menu after clicking a link
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }),
    );
  })();
</script>
