---

<footer class="relative px-6 lg:px-8 pt-12 pb-8">
  <!-- Top gold border -->
  <div class="max-w-6xl mx-auto h-px bg-gradient-to-r from-transparent via-accent-gold/40 to-transparent mb-10"></div>

  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
    <!-- Brand -->
    <div>
      <div class="font-display text-xl font-bold text-accent-gold">Protocolo Duarte</div>
      <p class="mt-3 text-sm text-foreground/60 max-w-xs">
        Negocios, cuerpo y mente. Tres pilares innegociables.
      </p>
    </div>

    <!-- Socials -->
    <div class="md:text-center">
      <div class="text-xs uppercase tracking-[0.25em] text-foreground/50 mb-3">
        Síguenos
      </div>
      <div class="flex md:justify-center gap-3">
        {socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.aria}
            class="inline-flex items-center justify-center w-9 h-9 rounded-md border border-white/10 text-foreground/70 hover:border-accent-gold hover:text-accent-gold transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d={s.svg} />
            </svg>
          </a>
        ))}
      </div>
      <div class="mt-3 text-sm text-foreground/60">@protocolo_duarte</div>
    </div>

    <!-- Contact -->
    <div class="md:text-right">
      <div class="text-xs uppercase tracking-[0.25em] text-foreground/50 mb-3">
        Contacto
      </div>
      <a
        href="mailto:ivduarte@iammtechs.com"
        class="text-foreground/80 hover:text-accent-gold transition-colors text-sm"
      >
        ivduarte@iammtechs.com
      </a>
    </div>
  </div>

  <div class="max-w-6xl mx-auto mt-12 pt-6 border-t border-white/5 text-xs text-foreground/40 text-center">
    &copy; {year} Protocolo Duarte · Todos los derechos reservados
  </div>
</footer>
