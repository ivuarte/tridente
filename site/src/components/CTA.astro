---
// CTA / waitlist section. Replace FORMSPREE_ID and the WhatsApp number
// when the real values are available.
const FORMSPREE_ID = 'meenqpby';
const WHATSAPP_NUMBER = '573005616824';
const WHATSAPP_MSG = encodeURIComponent(
  'Hola Protocolo Duarte, me interesa El Tridente.',
);
---

<section
  id="adquirir"
  class="relative py-20 md:py-28 px-6 lg:px-8 scroll-mt-20 bg-gradient-to-b from-[#0e0e0e] via-[#111] to-[#0a0a0a] border-y border-white/5"
>
  <!-- Soft gold halo -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(201,168,76,0.08),_transparent_60%)]"
  ></div>

  <div class="relative max-w-3xl mx-auto text-center">
    <span class="inline-block text-xs md:text-sm font-medium tracking-[0.25em] uppercase text-accent-gold">
      Adquirir
    </span>
    <h2 class="mt-4 font-display text-3xl sm:text-4xl md:text-5xl font-bold">
      Sé el primero en acceder
    </h2>
    <p class="mt-5 text-base md:text-lg text-foreground/75 max-w-xl mx-auto">
      El Tridente está próximo a lanzarse. Déjame tu email y serás el
      primero en saber el precio y la disponibilidad.
    </p>

    <!-- Waitlist form -->
    <form
      id="waitlist-form"
      action={`https://formspree.io/f/${FORMSPREE_ID}`}
      method="POST"
      class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-xl mx-auto text-left"
    >
      <div class="sm:col-span-1">
        <label for="cta-name" class="sr-only">Nombre</label>
        <input
          id="cta-name"
          type="text"
          name="name"
          required
          placeholder="Tu nombre"
          class="w-full px-4 py-3 rounded-md bg-black/60 border border-white/10 text-foreground placeholder-foreground/40 focus:outline-none focus:border-accent-gold focus:ring-1 focus:ring-accent-gold transition-colors"
        />
      </div>
      <div class="sm:col-span-1">
        <label for="cta-email" class="sr-only">Email</label>
        <input
          id="cta-email"
          type="email"
          name="email"
          required
          placeholder="tu@email.com"
          class="w-full px-4 py-3 rounded-md bg-black/60 border border-white/10 text-foreground placeholder-foreground/40 focus:outline-none focus:border-accent-gold focus:ring-1 focus:ring-accent-gold transition-colors"
        />
      </div>
      <div class="sm:col-span-2">
        <button
          type="submit"
          class="w-full inline-flex items-center justify-center gap-2 px-7 py-4 bg-accent-gold text-base font-semibold text-black rounded-md hover:brightness-110 transition-[filter,transform] duration-200 hover:-translate-y-0.5 shadow-lg shadow-accent-gold/20"
        >
          Quiero ser el primero
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </div>
    </form>

    <p
      id="waitlist-success"
      role="status"
      aria-live="polite"
      class="hidden mt-5 text-accent-green font-medium"
    >
      ¡Listo! Te avisamos cuando esté disponible.
    </p>

    <!-- Divider "O" -->
    <div class="mt-12 flex items-center gap-4 max-w-xs mx-auto">
      <div class="flex-1 h-px bg-white/10"></div>
      <span class="text-xs uppercase tracking-[0.3em] text-foreground/50">O</span>
      <div class="flex-1 h-px bg-white/10"></div>
    </div>

    <!-- WhatsApp -->
    <div class="mt-8">
      <a
        href={`https://wa.me/${WHATSAPP_NUMBER}?text=${WHATSAPP_MSG}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-3 px-7 py-4 rounded-md font-semibold text-white transition-[filter,transform] duration-200 hover:-translate-y-0.5 hover:brightness-110 shadow-lg shadow-black/40"
        style="background-color: #25D366;"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.52 3.48A11.78 11.78 0 0 0 12.04 0C5.5 0 .2 5.3.2 11.84c0 2.09.55 4.13 1.6 5.93L0 24l6.4-1.68a11.84 11.84 0 0 0 5.64 1.43h.01c6.55 0 11.85-5.3 11.85-11.84a11.78 11.78 0 0 0-3.38-8.43zM12.04 21.7h-.01a9.84 9.84 0 0 1-5.02-1.37l-.36-.21-3.8 1 1.02-3.7-.24-.38a9.83 9.83 0 0 1-1.5-5.2c0-5.43 4.42-9.84 9.86-9.84a9.78 9.78 0 0 1 6.97 2.89 9.78 9.78 0 0 1 2.89 6.96c0 5.43-4.42 9.85-9.81 9.85zm5.4-7.36c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.66.15-.2.3-.76.96-.93 1.16-.17.2-.34.22-.64.07-.3-.15-1.25-.46-2.39-1.46-.88-.78-1.48-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.34.45-.51.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.51-.07-.15-.66-1.6-.91-2.18-.24-.58-.48-.5-.66-.5l-.56-.01c-.2 0-.51.07-.78.37-.27.3-1.02 1-1.02 2.45s1.05 2.84 1.2 3.04c.15.2 2.06 3.15 5 4.42.7.3 1.24.48 1.66.62.7.22 1.33.19 1.83.12.56-.08 1.75-.71 2-1.4.25-.7.25-1.29.17-1.41-.08-.13-.27-.2-.57-.35z"/>
        </svg>
        Hablar con Protocolo Duarte
      </a>
    </div>
  </div>
</section>

<script is:inline>
  // Intercept submit and POST via fetch so we can show inline success
  // without redirecting away from the landing page.
  (function () {
    const form = document.getElementById('waitlist-form');
    const success = document.getElementById('waitlist-success');
    if (!form) return;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          form.classList.add('hidden');
          success.classList.remove('hidden');
        } else {
          // Fall back to native submit if Formspree returns an error
          form.submit();
        }
      } catch (err) {
        form.submit();
      }
    });
  })();
</script>
