---
// About section — personal brand story + 3 pillars + social links.
const pillars = [
  {
    icon: '🏢',
    title: 'Negocios',
    body: 'Sector tecnológico, toma de decisiones, ejecución sin excusas.',
  },
  {
    icon: '💪',
    title: 'Cuerpo',
    body: 'Entrenamiento con pesas, recuperación y rendimiento físico.',
  },
  {
    icon: '📚',
    title: 'Mente',
    body: 'Lectura constante, filosofía estoica y autodescubrimiento.',
  },
];

const socials = [
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/iv%C3%A1n-ramiro-duarte-aguirre-7901571ba/',
    aria: 'LinkedIn de Iván Ramiro Duarte',
    svg: 'M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8h4.56v14H.22V8zm7.5 0h4.37v1.92h.06c.61-1.15 2.1-2.36 4.32-2.36 4.62 0 5.47 3.04 5.47 6.99V22h-4.56v-6.21c0-1.48-.03-3.39-2.06-3.39-2.07 0-2.39 1.62-2.39 3.28V22H7.72V8z',
