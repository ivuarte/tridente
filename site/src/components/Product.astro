---
// Product section — El Tridente (3 cards: Proteína, Creatina, Omega-3).
const items = [
  {
    name: 'Proteína',
    icon: 'M12 2v20M5 7l7-5 7 5M5 7v10l7 5 7-5V7',
    body:
      'Recuperación muscular y síntesis proteica. El bloque estructural del rendimiento.',
  },
  {
    name: 'Creatina',
    icon: 'M13 2L3 14h7v8l10-12h-7V2z',
    body:
      'Fuerza, explosividad y rendimiento cognitivo. Energía para el cuerpo y la mente.',
  },
  {
    name: 'Omega-3',
    icon: 'M2 12c4-8 16-8 20 0M2 12c4 8 16 8 20 0M12 4v16',
    body:
      'Antiinflamatorio, salud cerebral y cardiovascular. El aceite del sistema.',
  },
];
---

<section id="producto" class="relative py-20 md:py-28 px-6 lg:px-8 scroll-mt-20">
  <!-- Faint top divider -->
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-accent-gold/40 to-transparent"></div>

  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-12 md:mb-16">
      <span class="inline-block text-xs md:text-sm font-medium tracking-[0.25em] uppercase text-accent-gold">
        El Tridente
      </span>
      <h2 class="mt-4 font-display text-3xl sm:text-4xl md:text-5xl font-bold max-w-3xl mx-auto">
        Las 3 herramientas del rendimiento
      </h2>
      <p class="mt-6 italic text-lg md:text-xl text-accent-gold font-display">
        “No es un suplemento. Es un protocolo.”
      </p>
    </div>

    <!-- Product image -->
    <div class="mb-14 md:mb-16 flex justify-center">
      <div class="relative w-full max-w-2xl aspect-[16/9] rounded-lg overflow-hidden border border-white/5 bg-gradient-to-br from-zinc-900 via-zinc-950 to-black">
        <img
          src="/images/product-tridente.png"
          alt="El Tridente — Proteína, Creatina y Omega-3"
          loading="lazy"
          class="w-full h-full object-contain"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
        <div
          class="hidden absolute inset-0 items-center justify-center"
          aria-hidden="true"
        >
          <div class="text-center">
            <div class="font-display text-3xl md:text-5xl font-bold text-gradient-gold">El Tridente</div>
            <div class="mt-2 text-sm md:text-base text-foreground/50 tracking-[0.25em] uppercase">
              Proteína · Creatina · Omega-3
            </div>
          </div>
        </div>
        <!-- Gold accent corner -->
        <div class="absolute top-0 left-0 w-12 h-12 border-t-2 border-l-2 border-accent-gold"></div>
        <div class="absolute bottom-0 right-0 w-12 h-12 border-b-2 border-r-2 border-accent-gold"></div>
      </div>
    </div>

    <!-- 3 cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
      {items.map((it) => (
        <article
          class="group relative bg-[#111] border border-white/5 border-l-4 border-l-accent-gold rounded-md p-6 md:p-7 hover:bg-[#141414] hover:-translate-y-1 transition-all duration-300"
        >
          <div class="flex items-center gap-3 mb-4">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-md bg-accent-gold/10 text-accent-gold">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d={it.icon} />
              </svg>
            </span>
            <h3 class="font-display text-2xl font-bold text-foreground">{it.name}</h3>
          </div>
          <p class="text-foreground/75 leading-relaxed">
            {it.body}
          </p>
        </article>
      ))}
    </div>

    <!-- Pack badge -->
    <div class="mt-12 md:mt-14 text-center">
      <div class="inline-flex items-center gap-3 px-5 py-3 rounded-full border border-accent-gold/40 bg-accent-gold/5">
        <span class="block w-2 h-2 rounded-full bg-accent-gold animate-pulse"></span>
        <span class="text-sm md:text-base font-medium" style="color: #f0f0f0;">
          <span style="color: #c9a84c; font-weight: 600;">Paquete completo</span> —
          <span style="color: #c9a84c;">Proteína + Creatina + Omega-3</span>
        </span>
      </div>
    </div>
  </div>
</section>
